# ============================================================
# Configuration — Automatisation Qualiopi Koban
# ============================================================
# Copier ce fichier en .env et renseigner les valeurs
# Le fichier .env ne doit JAMAIS être commité sur GitHub

# ------------------------------------------------------------
# LibreOffice — conversion Word → PDF
# ------------------------------------------------------------
# Le chemin vers soffice dépend de l'environnement d'exécution :
#   Streamlit Cloud (Linux) : /usr/bin/soffice
#   macOS                   : /Applications/LibreOffice.app/Contents/MacOS/soffice
#   Windows                 : C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=/usr/bin/soffice

# ------------------------------------------------------------
# Sécurité
# ------------------------------------------------------------
# Mot de passe pour protéger l'accès à l'app Streamlit (optionnel)
# Laisser vide pour désactiver la protection
APP_PASSWORD=

# ------------------------------------------------------------
# Organisme de formation (eBazten)
# ------------------------------------------------------------
# Ces valeurs sont fixes mais versionnées ici pour pouvoir
# les adapter si l'OF change ses coordonnées
OF_NOM=eBazten
OF_ADRESSE=2495 route de Forcalquier, 04300 Pierrerue
OF_TELEPHONE=06 69 64 80 09
OF_EMAIL=contact@koban-crm.com
OF_REPRESENTANT=Guillaume Lecanu
OF_REPRESENTANT_FONCTION=Gérant
OF_NUMERO_DECLARATION=82691206769
OF_DATADOCK=0029644
OF_SIREN=539304683
OF_FORMATRICE=Estelle Lecanu
OF_SIGNATAIRE=Estelle Lecanu, SARL Ebazten
OF_LIEU_JURIDICTION=Tribunal de Lyon

# ------------------------------------------------------------
# Tarification
# ------------------------------------------------------------
OF_TARIF_DEMI_JOURNEE=450
OF_TVA=20
OF_DEDOMMAGEMENT_ANNULATION=400

# ------------------------------------------------------------
# Questionnaires Google Forms
# ------------------------------------------------------------
QUESTIONNAIRE_CHAUD_URL=https://docs.google.com/forms/d/1pyD2p8OKvsyM-zOeQv2QQqEy0rprCIAs-nfM3vN6aE8/prefill
QUESTIONNAIRE_FROID_URL=https://docs.google.com/forms/d/1N73xIjPQfW7mae6OlJaXJRn8In1lx5HFUNXL4_xJG7I/prefill

# ------------------------------------------------------------
# Fichiers & dossiers
# ------------------------------------------------------------
# Dossier de sortie pour les fichiers générés (créé automatiquement)
OUTPUT_DIR=output

# ------------------------------------------------------------
# V2 — Intégration Koban CRM (non implémenté en MVP)
# ------------------------------------------------------------
# KOBAN_API_KEY=
# KOBAN_API_URL=https://app.koban.fr/api/v1
